FROM ghcr.io/cirruslabs/flutter:3.35.7 AS build
WORKDIR /workspace
COPY frontend/ ./
RUN flutter pub get && dart run build_runner build --delete-conflicting-outputs
ARG API_BASE_URL=/
RUN flutter build web --release --dart-define=API_BASE_URL=${API_BASE_URL}

FROM nginxinc/nginx-unprivileged:1.28-alpine
COPY deployment/nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/build/web/ /usr/share/nginx/html/
EXPOSE 8080